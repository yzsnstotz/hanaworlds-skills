{
  "name": "hanaworlds-skills",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HanaWorlds domain skills (D-13): engine-neutral SKILL.md bundles mounted into DSH through the upstream dsh-skill-filesystem customSkillDirs; no runtime plugin code",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanaworlds-skills.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "lint:skills": "node tools/lint-skills.mjs && node --test test/lint-skills.mjs test/reference-images.mjs test/image-materials.mjs",
    "test": "node --test test/*.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2 || 0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "yaml": "2.9.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2",
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.2",
    "pnpm": "10.23.0"
  }
}
